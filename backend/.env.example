DATABASE_URL="file:./dev.db"
JWT_SECRET="SecretKey9402948392048409473958392"
PORT=4000
# Có thể cấu hình nhiều origin, phân cách bằng dấu phẩy.
FRONTEND_URL="http://localhost:5173,https://techstore.onrender.com"
# Số proxy tin cậy; ví dụ 1 khi backend đứng sau một reverse proxy.
TRUST_PROXY=1
# Chỉ bật để kiểm thử đặt lại mật khẩu ở môi trường không phải production.
EXPOSE_RESET_TOKEN=false

# SMTP: leave blank to disable confirmation email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# VNPay merchant credentials and payment URL.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=
VNPAY_RETURN_URL=http://localhost:5173/thanh-toan/ket-qua

# MoMo credentials. Use the merchant-provided production endpoint; sandbox
# accounts should use their sandbox endpoint and callback URLs instead.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
MOMO_REDIRECT_URL=http://localhost:5173/thanh-toan/ket-qua
