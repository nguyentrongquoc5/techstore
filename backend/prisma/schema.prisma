generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  fullName  String
  phone     String   @default("")
  address   String   @default("")
  city      String   @default("")
  district  String   @default("")
  role      String   @default("USER") // USER | ADMIN
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  orders         Order[]
  reviews        Review[]
  wishlists      Wishlist[]
  passwordResets PasswordReset[]
  addresses      Address[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  products    Product[]
}

model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  brand        String
  price        Int
  salePrice    Int?
  stock        Int      @default(0)
  rating       Float    @default(4.5)
  reviewCount  Int      @default(0)
  description  String   @default("")
  specs        String   @default("{}") // JSON string
  images       String   @default("[]") // JSON array of paths
  isFeatured   Boolean  @default(false)
  isBestSeller Boolean  @default(false)
  status       String   @default("active") // active | inactive
  createdAt    DateTime @default(now())
  reviews      Review[]
  wishlists    Wishlist[]
  variants     ProductVariant[]
}

model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color         String  @default("")
  configuration String  @default("")
  price         Int?
  stock         Int     @default(0)
  sku           String  @unique
  isActive      Boolean @default(true)

  @@index([productId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("Nhà riêng")
  fullName  String
  phone     String
  address   String
  district  String
  city      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Order {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  userName      String
  userEmail     String
  items         String   // JSON array
  subtotal      Int
  discount      Int      @default(0)
  shippingFee   Int      @default(0)
  total         Int
  status        String   @default("pending") // pending processing shipping delivered cancelled
  paymentMethod String   @default("cod")
  paymentStatus String   @default("unpaid") // unpaid | paid
  paidAt        DateTime?
  couponCode    String?
  shippingInfo  String   // JSON
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  statusLogs    OrderStatusLog[]
}

model OrderStatusLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  changedBy String
  createdAt DateTime @default(now())
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String   // percent | fixed
  value       Int
  minOrder    Int      @default(0)
  maxDiscount Int?
  usageLimit  Int?
  usedCount   Int      @default(0)
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now())

  @@unique([productId, userId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Contact {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  message   String
  createdAt DateTime @default(now())
}
